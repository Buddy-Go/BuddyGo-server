# 서버의 docker-compose.yml 옆에 .env로 복사해 값을 채운다. .env는 절대 커밋하지 않는다.

# 배포할 이미지 태그 (CI가 커밋 SHA로 지정, 비우면 latest)
IMAGE_TAG=latest
SPRING_PROFILES_ACTIVE=prod

DB_NAME=buddygo
DB_USERNAME=buddygo
DB_PASSWORD=change-me

# 32바이트 이상. 예: openssl rand -base64 48
JWT_SECRET=change-me

# 푸시(FCM). Firebase 서비스 계정 JSON 을 docker-compose.yml 옆 ./secrets/ 에 두고 컨테이너 안 경로를 적는다.
# 비우면 푸시를 보내지 않는다(앱 알림 목록은 그대로 저장). 키 파일은 절대 커밋하지 않는다.
# 예: FIREBASE_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=
